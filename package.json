    "@escapace/pnpm-pack": "0.6.0",
    "@ls-lint/ls-lint": "2.3.1",
    "eslint": "9.35.0",
    "eslint-config-escapace": "5.10.0",
    "lefthook": "1.13.1",
    "prettier": "3.6.2",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.4",
    "tsd": "0.33.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "pnpm": ">=10.14.0"
  },
  "files": [
    "hkt.d.ts",
