{
  "name": "@escapace/typelevel",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/typelevel/issues",
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@escapace/pnpm-pack": "0.8.0",
    "@escapace/syncpack-configuration": "0.1.1",
    "@escapace/typelevel": "link:",
    "@ls-lint/ls-lint": "2.3.1",
    "eslint": "10.2.0",
    "eslint-config-escapace": "5.16.1",
    "lefthook": "2.1.5",
    "prettier": "3.8.3",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "14.3.0",
    "tsd": "0.33.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "pnpm": ">=10.14.0"
  },
  "files": [
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/typelevel",
  "license": "MPL-2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/typelevel",
  "scripts": {
    "build": "rm -rf lib/types && tsc -p tsconfig-build.json --emitDeclarationOnly --declarationDir lib/types",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "tsd --files src/index.test-d.ts",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "lib/types/index.d.ts"
}
